# Copy to .env and fill in.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# --- Only needed for real phone calls (leave empty for local testing via /local or npm run test:call) ---
# Used to verify that webhook requests really come from Twilio (Console > Account > API keys & tokens).
# Leave empty to skip the check during local testing.
TWILIO_AUTH_TOKEN=
# Your public tunnel host, no scheme, e.g. abcd-1234.ngrok-free.app
PUBLIC_HOST=

# Optional
# PORT=8080
# CLAUDE_MODEL=claude-opus-5-5        # claude-haiku-5-5 is faster and cheaper
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# VAD_SILENCE_SECS=0.8
# GREETING=Hi! How can I help you today?
# SYSTEM_PROMPT=You are a friendly, concise phone assistant...
# TEST_USER_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # voice of the simulated caller in npm run test:call
